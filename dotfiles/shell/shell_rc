    [[ -n "${prefix}" ]] || { log error "no prefix pattern given"; return 1; }
    while IFS= read -r file; do
        if [[ "${file}" == "${prefix}"* ]]; then
            printf '%s\n' "Skipping '${file}'"
        elif [[ -d "${file}" ]]; then
            printf '%s\n' "Skipping directory '${file}'"
        else
            [[ -f "${file}" ]] && mv -v "${file}" "${prefix}${file}"
        fi
    done < <( \
        find . -mindepth 1 -maxdepth 1 \
            \( -type f -o \( -type l -a -xtype f \) \) \
            -printf "%P\n" \
    )
}

