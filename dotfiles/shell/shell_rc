function log() {
    local _type="${1:-}"; shift
    local _color="" _t=""

    local info_color="\e[38;2;85;255;126m" warn_color="\e[38;2;255;170;10m" \
        error_color="\e[38;2;244;29;31m" fatal_color="\e[5m\e[38;2;255;0;0m" \
        other_color="\e[38;2;251;255;208m" nc="\e[0m"

    case "${_type}" in
        info) _color="${info_color:-}" _t="*" ;;
        warn) _color="${warn_color:-}" _t="^" ;;
        error) _color="${error_color:-}" _t="!" ;;
        fatal) _color="${fatal_color:-}" _t="#" ;;
        *) _color="${other_color:-}" _t="" ;;
    esac

    printf "[%b%s%b%s]: %b\n" "${_color}" "${_type}" "${nc}" "${_t}" "${*}"
}

function ColorPath() {
    local blue="\e[38;2;150;134;255m" nc="\e[0m"
    sed -e "s@${HOME}@${blue//\\/\\\\}~${nc//\\/\\\\}@g" <(printf "%s\n" "${1}")
}

function Bash_and_ZSH_setup() {
    local zsh_dir
    if [[ -n "$BASH_VERSION" ]]; then
        set -o vi
        export HISTCONTROL="ignoredups:erasedups"
        bind '"\C-o":"lfcd\n"'
        bind -m vi-insert '"\C-l": clear-screen'
        bind -m vi-command '"\C-l": clear-screen'
    elif [[ -n "$ZSH_VERSION" ]]; then
        export ZSH="${HOME}/.oh-my-zsh"
        CASE_SENSITIVE=true
        # ZSH_THEME="eastwood"
        plugins+=(vi-mode git gitfast docker pass)
        # shellcheck disable=SC1091
        source "${ZSH}/oh-my-zsh.sh"
        zsh_dir="$( \
            find /usr/share/zsh* \( -type d -o -type l \) -name 'zsh-syntax-highlighting' 2>/dev/null
        )"
        # shellcheck disable=SC1090
        source "${zsh_dir}"/*.zsh
        bindkey -s '^o' 'lfcd\n'
        autoload edit-command-line
        bindkey '^e' edit-command-line
        setopt HIST_IGNORE_DUPS
        setopt HIST_IGNORE_ALL_DUPS
        setopt HIST_SAVE_NO_DUPS
        setopt HIST_FIND_NO_DUPS
        setopt HIST_EXPIRE_DUPS_FIRST
        setopt NO_EXTENDED_HISTORY
        unsetopt EXTENDED_HISTORY
    fi
    mkdir -p -- "${TMPDIR}"
}

function ApplyShellTheme() {
    local arg="${1:-default}"
    local __ESC=$'\e' __bracket_color=""
    local __guessed_hardware=""

    if [[ -n "$BASH_VERSION" ]]; then
        local __pstart="\[" __pend="\]" \
            __username="\u" __hostname="\h" __work_dir="\w"
    elif [[ -n "$ZSH_VERSION" ]]; then
        local __pstart="%{" __pend="%}" \
            __username="%n" __hostname="%m" __work_dir="%~"
    fi

    if ! __guessed_hardware="$(grep CHASSIS_TYPE /etc/machine-info | \
        cut -d= -f2 2>/dev/null)"; then
        local is_detection_failed=no
        case "$(</sys/class/dmi/id/chassis_type)" in
            3|4)   __guessed_hardware="desktop"  ;;
            6|7)   __guessed_hardware="tower"    ;;
            8|9)   __guessed_hardware="laptop"   ;;
            10|14)__guessed_hardware="notebook"  ;;
            11)    __guessed_hardware="handheld" ;;
            31|32) __guessed_hardware="laptop"   ;;
            23|28) __guessed_hardware="server"   ;;
            24)    __guessed_hardware="chassis"  ;;
            [0-9]*) __guessed_hardware="desktop" ;;
            *) log error "failed to detect hardware"; is_detection_failed=yes ;;
        esac
        if [[ "${is_detection_failed}" == "yes" ]]; then
            __guessed_hardware="unknown"
        else
            if ask_user "save guessed machine info (${__guessed_hardware})? (y|n) or (c) for custom name: "; then
                printf '\n'; printf '%b\n' "#!/bin/sh\n\nCHASSIS_TYPE=${__guessed_hardware}\n" | \
                    sudo tee /etc/machine-info
            else
                if [[ $? -eq 10 ]]; then
                    local __cusom_name=""
                    printf '%b' "\ncustom name: "; read -r __cusom_name
                    if ask_user "save custom name? (y|n): "; then
                        printf '\n'; printf '%b\n' "#!/bin/sh\n\nCHASSIS_TYPE=${__cusom_name}\n" | \
                            sudo tee /etc/machine-info
                    fi
                fi
            fi
            __guessed_hardware="$(grep CHASSIS_TYPE /etc/machine-info | cut -d= -f2 2>/dev/null)"
        fi
    fi

    __FAINTED_GREEN="${__pstart}${__ESC}[38;2;163;240;96m${__pend}"
    __FAINTED_YELLOW="${__pstart}${__ESC}[38;2;231;245;180m${__pend}"
    __FAINTED_RED="${__pstart}${__ESC}[38;2;255;100;100m${__pend}"
    __BLUE_DIR="${__pstart}${__ESC}[38;2;89;159;240m${__pend}"
    __VIOLET="${__pstart}${__ESC}[38;2;129;137;223m${__pend}"
    __SKY_GREEN="${__pstart}${__ESC}[38;2;48;200;148m${__pend}"
    __WHITE="${__pstart}${__ESC}[38;2;200;200;200m${__pend}"
    __HL="${__pstart}${__ESC}[1m${__pend}" __NC="${__pstart}${__ESC}[0m${__pend}"

    if [[ -n "$BASH_VERSION" ]]; then
        # __bracket_color="${__pstart}${__ESC}[38;2;128;134;243m${__pend}"
        __bracket_color="${__pstart}${__ESC}[38;2;244;188;44m${__pend}"
        __OPEN="${__bracket_color}{{${__NC}" __CLOSE="${__bracket_color}}}${__NC}"
    elif [[ -n "$ZSH_VERSION" ]]; then
        __bracket_color="${__pstart}${__ESC}[38;2;243;110;102m${__pend}"
        __OPEN="${__bracket_color}::${__NC}" __CLOSE="${__bracket_color}::${__NC}"
    fi
    __GUESSED_HARDWARE="${__SKY_GREEN}${__guessed_hardware}://${__NC}"
    __USERNAME="${__FAINTED_GREEN}${__username}${__NC}"
    __HOSTNAME="${__FAINTED_YELLOW}${__hostname}${__NC}"
    __WORK_DIR="${__BLUE_DIR}${__work_dir}${__NC}"

    is_inside_git() {
        dir="${PWD:-}"
        while [[ "${dir}" != "" ]]; do
            [[ -d "${dir}/.git/" ]] && return 0
            dir="${dir%/*}"
        done
        return 1
    }

    # shellcheck disable=SC2329
    show_current_git_branch() {
        local __branch="" __string=""
        if is_inside_git && git status --short &>/dev/null; then
            local __git_dirty=""
            [[ -n "$(git status --porcelain)" ]] && __git_dirty="*"
            if __branch=$(git rev-parse --git-path rebase-merge &>/dev/null && \
                    git rev-parse --short --verify REBASE_HEAD 2>/dev/null); then
                __string="${__WHITE}git${__NC}:"
                __string+="${__SKY_GREEN}(${__NC}"
                __string+="${__WHITE}rebase:${__NC}"
                __string+="${__VIOLET}${__pstart}${__branch}${__pend}${__NC}"
                __string+="${__FAINTED_RED}${__git_dirty}${__NC}${__SKY_GREEN})${__NC} "
            else
                __string="${__WHITE}git${__NC}:"
                __string+="${__SKY_GREEN}(${__NC}"
                __string+="${__VIOLET}${__pstart}$(git symbolic-ref --short HEAD 2>/dev/null)${__pend}${__NC}"
                __string+="${__FAINTED_RED}${__git_dirty}${__NC}${__SKY_GREEN})${__NC} "
            fi
        fi
        printf '%b\n' "${__string}"
    }

    if [[ -n "$BASH_VERSION" ]]; then
        [[ "${arg}" =~ ^(simple|generic)$ ]] && { PROMPT_COMMAND='PS1="${__WORK_DIR} $(show_current_git_branch)$ "'; return 0; }
        PROMPT_COMMAND='PS1="${__OPEN} ${__GUESSED_HARDWARE}${__USERNAME}@${__HOSTNAME}:${__WORK_DIR} $(show_current_git_branch)${__CLOSE} $ "'
    elif [[ -n "$ZSH_VERSION" ]]; then
        autoload -Uz vcs_info
        zstyle ":vcs_info:git:*" formats "${__WHITE}git${__NC}:${__SKY_GREEN}(${__NC}${__VIOLET}%b${__NC}${__SKY_GREEN})${__NC} "
        zstyle ":vcs_info:git:*" actionformats ""
        precmd() { vcs_info; }
        [[ "${arg}" =~ ^(simple|generic)$ ]] && { PROMPT='${__WORK_DIR} ${vcs_info_msg_0_}$ '; return 0; }
        PROMPT='${__OPEN} ${__GUESSED_HARDWARE}${__USERNAME}@${__HOSTNAME}:${__WORK_DIR} ${vcs_info_msg_0_}${__CLOSE} $ '
    fi
}

