### Set refresh rate
function set_refresh_rate_to() {
    local -i req_hz=$1
    local output="" mode=""
    local px="" hz=""

    if [[ "${XDG_SESSION_TYPE}" == wayland ]]; then
        output="$(wlr-randr | head -n1 | cut -d' ' -f1)"
        px=$(wlr-randr | grep current | awk -F' ' '{ print $1 }')
        hz=$(wlr-randr | grep -P "(?=.*${px})(?=.*${req_hz})" | grep -o -E "${req_hz}\.[0-9]+")
        mode="${px}px@${hz}Hz"
        if ! wlr-randr --output "${output}" --mode "${mode}" && return 0; then
            log error "Cannot set $req_hz"
        fi
    elif [[ "${XDG_SESSION_TYPE}" == x11 ]]; then
        output=$(xrandr | grep 'connected primary' | cut -d' ' -f1)
        px=$(xrandr | grep '\*' | awk -F' ' '{ print $1 }')
        hz=$(xrandr | grep "${px}" | grep -Eo "${req_hz}\.[0-9]+")
        log info "xrandr --output ${output} --mode ${px} --rate ${hz}"
        xrandr --output "${output}" --mode "${px}" --rate "${hz}" || log error "Cannot set $req_hz"
    fi
}

